# ChefGuru — environment variables
# Copy this file to .env and fill in real values.
# Never commit the actual .env file — only this example.

# Supabase project settings → API
# https://app.supabase.com/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Added in a later phase (ChefGuru AI chat) — leave blank until Phase E
# This should live server-side only; the app will call your backend proxy,
# never the LLM provider directly, so this key never ships in the app bundle.
# AI_PROVIDER_API_KEY=
